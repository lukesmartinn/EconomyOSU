# Generic .dockerignore for most projects.
# Excludes VCS, IDE, OS, deps, build artifacts, secrets, and CI metadata
# from the Docker build context. The Dockerfile is responsible for
# installing fresh deps and building inside the image.
#
# IMPORTANT: this template does NOT exclude `Dockerfile`, `.dockerignore`,
# or any config files (like `nginx.conf`, `package.json`, `tsconfig.json`)
# that the Dockerfile needs to COPY.

# VCS
.git
.gitignore
.gitattributes
.github
.gitlab

# IDE / editor
.vscode
.idea
.vs
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Node / Bun / package managers
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.venv
venv
env
.tox
.pytest_cache
.mypy_cache
.ruff_cache
*.egg-info
dist
build

# Go
vendor

# Rust
target

# Java / Gradle / Maven
.gradle
*.class
*.jar
*.war
.m2

# Build outputs (typical SPA / framework defaults — Dockerfile rebuilds inside)
.next
.nuxt
.output
.svelte-kit
.astro
.cache
out
coverage

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Logs / temp
*.log
logs
tmp
temp

# CI / containers (avoid recursive context bloat)
docker-compose*.yml
Dockerfile.dev
.dockerignore.dev
